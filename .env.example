# Salin file ini menjadi ".env" (di folder yang sama) lalu sesuaikan nilainya.
# JANGAN commit file .env ke Git.

# --- Dibaca docker-compose (membuat database Postgres) ---
POSTGRES_USER=freshsense
POSTGRES_PASSWORD=ganti-dengan-sandi-kuat
POSTGRES_DB=freshsense

# --- Dibaca aplikasi FastAPI ---
# Sandi dan nama database di bawah HARUS sama dengan yang di atas.
DATABASE_URL=postgresql+psycopg://freshsense:ganti-dengan-sandi-kuat@localhost:5432/freshsense

# WAJIB diganti (Tahap 3): kunci penandatangan cookie login. Buat nilai acak dengan:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Ganti kunci = semua orang yang sedang login harus login lagi.
SECRET_KEY=ganti-dengan-nilai-acak

# Lokasi folder frontend, relatif terhadap folder backend/ (tempat uvicorn dijalankan)
FRONTEND_DIR=../frontend

# --- Sesi login (opsional, ini nilai bawaan) ---
# SESSION_HOURS=12
# COOKIE_SECURE=false     # ganti true HANYA saat situs dilayani lewat HTTPS
